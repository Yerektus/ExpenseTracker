# Скопируйте этот файл в .env (в корне репозитория) и при необходимости измените значения.
# Все переменные необязательны: без .env используются значения по умолчанию ниже.

# Backend: строка подключения SQLAlchemy (по умолчанию — backend/expenses.db)
# DATABASE_URL=sqlite:///./expenses.db

# Backend: разрешённые CORS-источники через запятую
CORS_ORIGINS=http://localhost:5173

# Frontend: адрес backend API
VITE_API_URL=http://localhost:8000
